# LinkedIn OAuth app credentials (create an app at https://www.linkedin.com/developers/apps
# and enable the "Sign In with LinkedIn using OpenID Connect" product)
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# Postgres connection string (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tross

# Random secret used to sign/protect session cookies - generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-in-production

SESSION_COOKIE_NAME=tross_session
LINKEDIN_SCOPES=openid profile email
